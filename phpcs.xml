<?xml version="1.0"?>
<ruleset name="CraftyCrochetCorner">
    <description>Coding standard for Crafty Crochet Corner</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>.</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Templates mix HTML with PHP and often carry long attribute/markup lines. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- Pure-HTML partials (e.g. includes/header.php) legitimately contain no PHP. -->
    <rule ref="Internal.NoCodeFound">
        <severity>0</severity>
    </rule>

    <!-- PSR-12 doesn't police stray whitespace around operators or trailing blank lines. -->
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <!-- Also flag extra spaces before "=" etc., not just after. -->
            <property name="ignoreSpacingBeforeAssignments" value="false"/>
        </properties>
    </rule>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>
</ruleset>
